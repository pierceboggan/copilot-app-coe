---
import Octicon from '../components/Octicon.astro';
import { beyondCode } from '../data/beyondCode';
import { phases, totalItems } from '../data/checklist';
import { roles } from '../data/roles';
import Base from '../layouts/Base.astro';
import { href } from '../lib/paths';

const useCaseCount = roles.reduce((n, r) => n + (r.useCases?.length ?? 0), 0);
const engCount = roles.find((r) => r.slug === 'engineer')?.useCases?.length ?? 0;
---
<Base title="Home">
  <section class="coe-hero">
    <div class="coe-container">
      <p class="coe-eyebrow mb-3">GitHub Copilot app Enablement Center</p>
      <h1 class="coe-display mb-4" style="max-width: 900px">
        Accelerate your engineers, for all types of work
      </h1>
      <p class="coe-lede mb-5">
        Your engineers hand the app a bug fix, a teammate's review, a flaky test investigation and a design doc, and all
        four run at the same time. They spend the day scoping work and reviewing results. This site shows your team how
        to get there.
      </p>
      <p id="hero-example" class="f6 mb-2" style="color:#9198a1">One engineer's morning, five sessions in parallel (illustrative example)</p>
      <ul class="coe-hero-result list-style-none mb-6" aria-labelledby="hero-example">
        <li><Octicon name="git-pull-request" /> Fix for the checkout bug, pull request open</li>
        <li><Octicon name="eye" /> Review of a teammate's pull request, comments drafted</li>
        <li><Octicon name="bug" /> Flaky test traced to a race in the retry logic</li>
        <li><Octicon name="file" /> Design doc for the cache rewrite, first draft ready</li>
        <li><Octicon name="project-template" /> Sprint demo deck built from merged work</li>
      </ul>
      <h2 class="h4 mb-3" style="color:#f0f6fc">Where do you want to start?</h2>
      <div class="coe-audience">
        <a class="coe-audience-card" href={href('/parallel/#try-it')}>
          <span class="coe-audience-who">Engineers</span>
          <span class="coe-audience-what">Install the app and run your first parallel prompt</span>
          <span class="coe-audience-go">Try it in ten minutes →</span>
        </a>
        <a class="coe-audience-card" href={href('/resources/#team-kit')}>
          <span class="coe-audience-who">Team leads</span>
          <span class="coe-audience-what">Get your team running several sessions at once this week</span>
          <span class="coe-audience-go">Get the team kit →</span>
        </a>
        <a class="coe-audience-card" href={href('/coe/admin-guide/')}>
          <span class="coe-audience-who">Admins</span>
          <span class="coe-audience-what">Set up policies, models and MCP servers, then launch</span>
          <span class="coe-audience-go">Open the admin guide →</span>
        </a>
      </div>
      <div class="d-flex gap-6 mt-8 flex-wrap">
        <div><div class="coe-stat">{engCount}</div><div style="color:#9198a1">engineer workflows</div></div>
        <div><div class="coe-stat">{useCaseCount}</div><div style="color:#9198a1">ready-to-run prompts</div></div>
        <div><div class="coe-stat">{totalItems}</div><div style="color:#9198a1">rollout checklist items</div></div>
      </div>
    </div>
  </section>

  <section class="coe-section" aria-labelledby="parallel-work">
    <div class="coe-container">
      <p class="coe-eyebrow mb-2">How it works</p>
      <h2 class="coe-h2 mb-2" id="parallel-work">The speed comes from running work in parallel</h2>
      <p class="coe-lede mb-5">
        Each session gets its own workspace and branch. An engineer starts the next task while the last one runs, then
        reviews each result when it lands. One session can also split a job and start the others.
      </p>
      <div class="coe-grid">
        <a class="coe-card" href={href('/parallel/#sessions')}>
          <span class="coe-card-icon"><Octicon name="git-branch" size={20} /></span>
          <h3>Several sessions at once</h3>
          <p>Give each task its own session. Review each one when it finishes, in any order.</p>
        </a>
        <a class="coe-card" href={href('/parallel/#spawn')}>
          <span class="coe-card-icon"><Octicon name="repo-forked" size={20} /></span>
          <h3>Let the agent split the work</h3>
          <p>Ask for child sessions, or use <code>/spawn</code> and <code>/fleet</code>. Nested sessions sit under their parent.</p>
        </a>
        <a class="coe-card" href={href('/parallel/#orchestrate')}>
          <span class="coe-card-icon"><Octicon name="repo" size={20} /></span>
          <h3>Work across repositories</h3>
          <p>Select several projects or run <code>/orchestrate</code> to coordinate one change with a pull request per repository.</p>
        </a>
        <a class="coe-card" href={href('/parallel/#automations')}>
          <span class="coe-card-icon"><Octicon name="clock" size={20} /></span>
          <h3>Keep it running on a schedule</h3>
          <p>Automations wake a session each day or week, so recurring work happens without anyone starting it.</p>
        </a>
      </div>
      <p class="mt-4"><a href={href('/parallel/')}>Learn when to split work and how to review many results →</a></p>
    </div>
  </section>

  <section class="coe-section coe-section-muted" aria-labelledby="why-now">
    <div class="coe-container">
      <p class="coe-eyebrow mb-2">Why now</p>
      <h2 class="coe-h2 mb-4" id="why-now">AI is already part of how developers start</h2>
      <div class="d-flex gap-6 flex-wrap mb-3">
        <div style="max-width:340px">
          <div class="coe-stat">80%</div>
          <p class="color-fg-muted mb-0">of new developers on GitHub use Copilot in their first week.</p>
        </div>
        <div style="max-width:340px">
          <div class="coe-stat">518.7M</div>
          <p class="color-fg-muted mb-0">pull requests merged on GitHub in a year, a record and up 29% year over year.</p>
        </div>
      </div>
      <p class="f6 color-fg-muted mb-0">
        Source: <a href="https://github.blog/news-insights/octoverse/octoverse-a-new-developer-joins-github-every-second-as-ai-leads-typescript-to-1/">GitHub Octoverse 2025</a>.
        A CoE turns that early habit into shared practice. <a href={href('/stories/')}>See what that can look like →</a>
      </p>
    </div>
  </section>

  <section class="coe-section" aria-labelledby="beyond-code">
    <div class="coe-container">
      <p class="coe-eyebrow mb-2">All types of work</p>
      <h2 class="coe-h2 mb-2" id="beyond-code">More than writing code</h2>
      <p class="coe-lede mb-5">
        Most of an engineer's week goes to the work around the code. Bug investigations, design docs, triage, incident
        follow-up and the status update can each run in a session of their own. The same patterns work for the rest of
        the team.
      </p>
      <div class="coe-grid">
        {beyondCode.map((theme) => (
          <div class="coe-card" id={`beyond-${theme.id}`}>
            <span class="coe-card-icon"><Octicon name={theme.icon} size={20} /></span>
            <h3>{theme.title}</h3>
            <p>{theme.summary}</p>
            <ul class="list-style-none f6 mt-auto">
              {theme.links.map((l) => (
                <li class="mt-1"><a href={href(l.path)}>{l.label} →</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="mt-4"><a href={href('/which-tool/#more-than-writing-code')}>Which tool for which job →</a></p>
    </div>
  </section>

  <section class="coe-section coe-section-muted">
    <div class="coe-container">
      <p class="coe-eyebrow mb-2">Start here</p>
      <h2 class="coe-h2 mb-5">Pick your path</h2>
      <div class="coe-grid">
        <a class="coe-card" href={href('/get-started/')}>
          <span class="coe-card-icon"><Octicon name="rocket" size={20} /></span>
          <h3>New to the app</h3>
          <p>A four-module learning path. Finish a real task in your first hour, then build the habits over a month.</p>
        </a>
        <a class="coe-card" href={href('/coe/')}>
          <span class="coe-card-icon"><Octicon name="organization" size={20} /></span>
          <h3>Leading the rollout</h3>
          <p>Roles, cadence and metrics for running a Copilot app Center of Excellence.</p>
        </a>
        <a class="coe-card" href={href('/coe/checklist/')}>
          <span class="coe-card-icon"><Octicon name="tasklist" size={20} /></span>
          <h3>Tracking progress</h3>
          <p>Work through Pilot, Expand, Scale and Optimize. Progress saves in your browser.</p>
          <span class="mt-auto" data-coe-home-progress hidden>
            <span class="d-flex flex-justify-between f6 color-fg-muted mb-1">
              <span>Your progress</span><span data-coe-home-progress-label></span>
            </span>
            <span class="Progress"><span class="Progress-item color-bg-success-emphasis" data-coe-home-progress-bar style="width:0%"></span></span>
          </span>
        </a>
        <a class="coe-card" href={href('/coe/admin-guide/')}>
          <span class="coe-card-icon"><Octicon name="shield-check" size={20} /></span>
          <h3>Setting it up</h3>
          <p>The admin guide: policies, models, MCP servers and plugins, then launch, training and scaling.</p>
        </a>
        <a class="coe-card" href={href('/prompts/')}>
          <span class="coe-card-icon"><Octicon name="copilot" size={20} /></span>
          <h3>Looking for a prompt</h3>
          <p>Every prompt on the site in one place. Filter by role, feature or the metric you want to move.</p>
        </a>
        <a class="coe-card" href={href('/coe/assessment/')}>
          <span class="coe-card-icon"><Octicon name="goal" size={20} /></span>
          <h3>Not sure where you are</h3>
          <p>Answer ten questions to find the rollout phase to focus on next.</p>
        </a>
        <a class="coe-card" href={href('/resources/')}>
          <span class="coe-card-icon"><Octicon name="download" size={20} /></span>
          <h3>Need templates</h3>
          <p>Admin briefing, launch emails, starter prompts, demo day formats and an ROI worksheet.</p>
        </a>
        <a class="coe-card" href={href('/which-tool/')}>
          <span class="coe-card-icon"><Octicon name="question" size={20} /></span>
          <h3>Choosing a tool</h3>
          <p>App, CLI, editor, automations or cloud agent. Start from the problem and pick the right one.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="coe-section">
    <div class="coe-container">
      <p class="coe-eyebrow mb-2">Use cases</p>
      <h2 class="coe-h2 mb-2">Engineers first, then the whole team</h2>
      <p class="coe-lede mb-5">Each role has a day-in-the-life walkthrough and prompts you can open straight in the app.</p>
      <div class="coe-grid">
        {roles.map((role) =>
          role.available ? (
            <a class="coe-card" href={href(`/roles/${role.slug}/`)}>
              <span class="coe-card-icon"><Octicon name={role.icon} size={20} /></span>
              <h3>{role.name}</h3>
              <p>{role.tagline}</p>
              <span class="f6 color-fg-accent mt-auto">{role.useCases?.length} use cases →</span>
            </a>
          ) : (
            <div class="coe-card coe-card-disabled">
              <span class="coe-card-icon"><Octicon name={role.icon} size={20} /></span>
              <h3>{role.name}</h3>
              <p>{role.tagline}</p>
              <span class="Label mt-auto" style="align-self:flex-start">Coming soon</span>
            </div>
          ),
        )}
      </div>
    </div>
  </section>

  <section class="coe-section coe-section-muted">
    <div class="coe-container">
      <p class="coe-eyebrow mb-2">Rollout</p>
      <h2 class="coe-h2 mb-5">From validation sprint to org-wide launch in a month</h2>
      <ol class="coe-grid list-style-none">
        {phases.map((phase, i) => (
          <li class="coe-card">
            <span class="Label Label--done" style="align-self:flex-start">Phase {i + 1} · {phase.timeframe}</span>
            <h3>{phase.nickname} <span class="color-fg-muted text-normal f5">({phase.name})</span></h3>
            <p>{phase.goal}</p>
            <a class="f6 mt-auto" href={href(`/coe/checklist/#${phase.id}`)}>{phase.items.length} checklist items →</a>
          </li>
        ))}
      </ol>
      <p class="mt-4"><a href={href('/playbooks/')}>See week-by-week playbooks for a team of 10 and an organization of 1,000 →</a></p>
    </div>
  </section>
</Base>

<script>
  import { totalItems } from '../data/checklist';

  try {
    const done: string[] = JSON.parse(localStorage.getItem('coe:checklist') ?? '[]');
    const count = Array.isArray(done) ? done.length : 0;
    const wrap = document.querySelector<HTMLElement>('[data-coe-home-progress]');
    if (wrap && count > 0) {
      const pct = Math.round((Math.min(count, totalItems) / totalItems) * 100);
      wrap.querySelector('[data-coe-home-progress-label]')!.textContent = `${count} of ${totalItems}`;
      wrap.querySelector<HTMLElement>('[data-coe-home-progress-bar]')!.style.width = `${pct}%`;
      wrap.hidden = false;
    }
  } catch {}
</script>
