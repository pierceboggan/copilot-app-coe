---
import Octicon from '../../components/Octicon.astro';
import PromptBlock from '../../components/PromptBlock.astro';
import RepoSetting from '../../components/RepoSetting.astro';
import { availableRoles, featureStatus, type Role } from '../../data/roles';
import { outcomeById, outcomesFor } from '../../data/outcomes';
import Base from '../../layouts/Base.astro';
import { href } from '../../lib/paths';

export function getStaticPaths() {
  return availableRoles.map((role) => ({ params: { slug: role.slug }, props: { role } }));
}

const { role } = Astro.props as { role: Role };
const useCases = role.useCases ?? [];
const features = [...new Set(useCases.flatMap((u) => u.features))].sort();
const groupNames = [...new Set(useCases.map((u) => u.group ?? ''))];
const grouped = groupNames.some(Boolean);
const groups = groupNames.map((name) => ({
  name,
  id: name ? `group-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}` : '',
  intro: role.groupIntros?.[name],
  items: useCases.filter((u) => (u.group ?? '') === name),
}));
const Title = grouped ? 'h4' : 'h3';
---
<Base title={`${role.name} use cases`} description={role.tagline}>
  <section class="coe-page-hero">
    <div class="coe-container">
      <nav aria-label="Breadcrumb" class="mb-3 f5">
        <a href={href('/roles/')}>Use cases</a> <span style="color:#9198a1">/ {role.name}</span>
      </nav>
      <div class="d-flex flex-items-center gap-3 mb-3">
        <span class="coe-card-icon" style="width:48px;height:48px"><Octicon name={role.icon} size={24} /></span>
        <h1 class="coe-h1">{role.name}</h1>
      </div>
      <p class="coe-lede">{role.tagline}</p>
    </div>
  </section>

  <div class="coe-container py-6">
    <div class="d-flex flex-column flex-lg-row gap-6">
      <aside class="flex-shrink-0" style="width: 100%; max-width: 280px">
        <div class="position-sticky d-flex flex-column gap-4" style="top: 88px">
          <RepoSetting />
          <nav class="coe-toc" aria-label="Use cases on this page">
            <h2 class="f6 text-uppercase color-fg-muted mb-2">On this page</h2>
            <a href="#day-in-the-life">A day in the life</a>
            {groups.map((g) => (
              <>
                {g.name && <a href={`#${g.id}`} class="text-bold">{g.name}</a>}
                {g.items.map((u) => <a href={`#${u.id}`} class={g.name ? 'pl-3' : undefined}>{u.title}</a>)}
              </>
            ))}
            <a href="#pitfalls">Pitfalls to avoid</a>
          </nav>
        </div>
      </aside>

      <div class="flex-1 min-width-0">
        <section id="day-in-the-life" class="mb-6">
          <h2 class="coe-h2 mb-4">A day in the life</h2>
          <div class="TimelineItem-group">
            {role.dayInTheLife?.map((entry) => (
              <div class="TimelineItem">
                <div class="TimelineItem-badge"><Octicon name="clock" /></div>
                <div class="TimelineItem-body">
                  <span class="text-bold color-fg-default mr-2">{entry.time}</span>{entry.text}
                </div>
              </div>
            ))}
          </div>
        </section>

        <section aria-labelledby="use-cases-heading">
          <div class="d-flex flex-wrap flex-items-center flex-justify-between gap-2 mb-4">
            <h2 id="use-cases-heading" class="coe-h2">Use cases</h2>
            <div class="d-flex flex-items-center gap-2">
              <label for="feature-filter" class="f6 color-fg-muted">Filter by feature</label>
              <select id="feature-filter" class="form-select select-sm" data-coe-feature-filter>
                <option value="">All features</option>
                {features.map((f) => <option value={f}>{f}</option>)}
              </select>
            </div>
          </div>
          <p class="sr-only" aria-live="polite" data-coe-filter-status></p>

          {groups.map((g) => (
          <div class="mb-5" data-coe-group>
          {g.name && (
            <div class="mb-3">
              <h3 id={g.id} class="h3">{g.name}</h3>
              {g.intro && <p class="color-fg-muted mb-0">{g.intro}</p>}
            </div>
          )}
          <div class="d-flex flex-column gap-4">
            {g.items.map((u) => (
              <article id={u.id} class="Box p-4" data-features={u.features.join('|')}>
                <Title class="h3 mb-1">{u.title}</Title>
                <p class="color-fg-muted mb-3">{u.summary}</p>
                <div class="d-flex flex-wrap gap-1 mb-3">
                  {u.features.map((f) => (
                    <span class={`Label ${featureStatus[f] ? 'Label--attention' : 'Label--accent'}`}>
                      {f}{featureStatus[f] && <span>: {featureStatus[f]!.label}</span>}
                    </span>
                  ))}
                </div>
                {u.features.some((f) => featureStatus[f]) && (
                  <div class="flash flash-warn mb-3 f6">
                    {u.features.filter((f) => featureStatus[f]).map((f) => (
                      <p class="mb-1"><strong>{f}:</strong> {featureStatus[f]!.note}</p>
                    ))}
                  </div>
                )}
                {u.demo && (
                  <figure class="coe-demo mb-3">
                    <img src={href(u.demo.src)} width={u.demo.width} height={u.demo.height} alt={u.demo.alt} loading="lazy" decoding="async" />
                    <figcaption class="f6 color-fg-muted mt-1">
                      {u.demo.caption} Real app component rendered with test data.
                    </figcaption>
                  </figure>
                )}
                {u.steps && (
                  <ol class="ml-4 mb-3">
                    {u.steps.map((s) => <li>{s}</li>)}
                  </ol>
                )}
                <PromptBlock prompt={u.prompt} mode={u.mode} />
                <p class="mt-3 mb-0 d-flex gap-2">
                  <span class="color-fg-success"><Octicon name="check-circle" /></span>
                  <span><strong>Outcome:</strong> {u.outcome}</span>
                </p>
                <p class="mt-2 mb-0 d-flex flex-wrap flex-items-center gap-1 f6">
                  <span class="color-fg-muted"><Octicon name="graph" /> Moves:</span>
                  {outcomesFor(u.id).map((o) => (
                    <a class="Label Label--success" href={href(`/coe/metrics/#${o}`)}>{outcomeById[o].label}</a>
                  ))}
                </p>
              </article>
            ))}
          </div>
          </div>
          ))}
        </section>

        <section id="pitfalls" class="mt-6">
          <h2 class="coe-h2 mb-3">Pitfalls to avoid</h2>
          <div class="flash flash-warn">
            <ul class="ml-3">
              {role.pitfalls?.map((p) => <li class="mb-1">{p}</li>)}
            </ul>
          </div>
        </section>
      </div>
    </div>
  </div>
</Base>

<script>
  const select = document.querySelector<HTMLSelectElement>('[data-coe-feature-filter]');
  const status = document.querySelector<HTMLElement>('[data-coe-filter-status]');
  const cards = [...document.querySelectorAll<HTMLElement>('article[data-features]')];
  select?.addEventListener('change', () => {
    const value = select.value;
    let shown = 0;
    for (const card of cards) {
      const match = !value || (card.dataset.features ?? '').split('|').includes(value);
      card.hidden = !match;
      if (match) shown++;
    }
    for (const group of document.querySelectorAll<HTMLElement>('[data-coe-group]')) {
      group.hidden = !group.querySelector('article:not([hidden])');
    }
    if (status) status.textContent = `${shown} use case${shown === 1 ? '' : 's'} shown`;
  });
</script>
