---
import octicons from '@primer/octicons';

interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 16, class: className, label } = Astro.props;
const icon = octicons[name];
if (!icon) throw new Error(`Unknown octicon: ${name}`);
const svg = icon.toSVG({
  width: size,
  height: size,
  ...(className ? { class: className } : {}),
  ...(label ? { 'aria-label': label, role: 'img' } : { 'aria-hidden': 'true' }),
});
---
<Fragment set:html={svg} />
